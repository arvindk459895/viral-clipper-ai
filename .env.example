# ========================================================
# ViralClipper AI Studio - Environment Variables
# ========================================================

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
# Note: You can also enter and save your key directly in the web app sidebar!
GEMINI_API_KEY=your_gemini_api_key_here

# Active Gemini Model (Optional, defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
